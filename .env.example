# Virtual Eye 3.0 - Environment Configuration

# Backend API URL
# Vite exposes only VITE_-prefixed vars to the client (import.meta.env.VITE_API_URL).
# Local Flask server (default)
VITE_API_URL=http://localhost:5000

# Alternative: Remote/ngrok URL (for testing on different networks)
# VITE_API_URL=https://your-ngrok-url.ngrok.io

# Alternative: Docker/production deployment
# VITE_API_URL=http://api.yourdomain.com
